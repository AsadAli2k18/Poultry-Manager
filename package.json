{
  "name": "poultry-manager",
  "version": "1.0.0",
  "description": "Poultry Manager - offline desktop software for a poultry and meat shop",
  "main": "desktop/main.js",
  "author": "AASolutions (0305-8592435)",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "test": "node tools/run-selftest.js",
    "vendor": "node tools/copy-vendor.js",
    "demo": "node tools/serve.js",
    "icon": "electron tools/make-icon.js",
    "secugen": "node tools/secugen.js",
    "screenshots": "electron tools/screenshots.js"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "@fontsource/noto-nastaliq-urdu": "^5.1.0",
    "bootstrap-icons": "^1.11.3",
    "htm": "^3.1.1",
    "preact": "^10.24.3"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "build": {
    "appId": "pk.poultrymanager.app",
    "productName": "Poultry Manager",
    "copyright": "© 2026 AASolutions",
    "files": [
      "app/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "desktop/vendor/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Poultry Manager",
      "installerIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "PoultryManager-Setup-${version}.exe"
    }
  }
}
